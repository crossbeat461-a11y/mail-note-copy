{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "ja",
  "version": "1.0.0",
  "author": "K-Tech-Studio",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-note-copy@k-tech-studio.com",
      "strict_min_version": "115.0",
      "strict_max_version": "158.*"
    }
  },
  "permissions": [
    "messagesRead",
    "menus",
    "clipboardWrite",
    "downloads"
  ],
  "background": {
    "scripts": [
      "htmlToMarkdown.js",
      "note.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "experiment_apis": {
    "mailNoteFiles": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["mailNoteFiles"]],
        "script": "api/implementation.js"
      }
    }
  }
}
